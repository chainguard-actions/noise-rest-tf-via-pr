#!/usr/bin/env bash
# Fake terraform/tofu CLI used by the tests. Logs every invocation and emits
# realistic-looking output so the action's argument building and output
# parsing can be checked without a real backend.
echo "$(basename "$0") $*" >> /tmp/tf-calls.log
if [[ "$1" == -chdir=* ]]; then
  cd "${1#-chdir=}" || { echo "Error: chdir ${1#-chdir=} not found"; exit 1; }
  shift
fi
cmd="$1"
shift
case "$cmd" in
  fmt)
    exit 0
    ;;
  init)
    echo "Terraform has been successfully initialized!"
    exit 0
    ;;
  validate)
    echo "Success! The configuration is valid."
    exit 0
    ;;
  plan)
    out=""
    detailed=""
    for a in "$@"; do
      case "$a" in
        -out=*) out="${a#-out=}" ;;
        -detailed-exitcode) detailed=1 ;;
      esac
    done
    echo "Terraform will perform the following actions:"
    echo "  # null_resource.example will be created"
    echo "Plan: 1 to add, 0 to change, 0 to destroy."
    if [[ -n "$out" ]]; then echo "FAKE-PLAN-CONTENT" > "$out"; fi
    if [[ -n "$detailed" ]]; then exit 2; fi
    exit 0
    ;;
  show)
    if [[ "$1" == "-json" ]]; then
      echo '{"resource_changes":[]}'
      exit 0
    fi
    if [[ ! -f "$1" ]]; then echo "Error: plan file $1 not found" >&2; exit 1; fi
    echo "Terraform will perform the following actions:"
    echo ""
    echo "  # null_resource.example will be created"
    echo "  + resource \"null_resource\" \"example\" {"
    echo "    }"
    echo ""
    echo "Plan: 1 to add, 0 to change, 0 to destroy."
    exit 0
    ;;
  apply)
    for a in "$@"; do
      case "$a" in
        -*) ;;
        *)
          if [[ ! -f "$a" ]]; then echo "Error: plan file $a not found"; exit 1; fi
          echo "applying plan content: $(cat "$a")" >> /tmp/tf-calls.log
          ;;
      esac
    done
    echo "Apply complete! Resources: 1 added, 0 changed, 0 destroyed."
    exit 0
    ;;
  *)
    echo "Error: unknown command $cmd"
    exit 1
    ;;
esac
